import { getRawSQLiteDB } from '../config/databaseManager.js';

// Get all data registrations
export const getAllRegistrations = async (req, res, next) => {
  try {
    const db = getRawSQLiteDB();
    
    if (!db) {
      return res.status(500).json({
        success: false,
        message: 'Database not available'
      });
    }

    const registrations = db.prepare('SELECT * FROM data_registrations ORDER BY created_at DESC').all();
    
    // Convert _id to id for frontend compatibility
    const formattedRegistrations = registrations.map(reg => ({
      ...reg,
      id: reg._id
    }));

    res.json({
      success: true,
      data: formattedRegistrations
    });
  } catch (error) {
    console.error('Failed to get registrations:', error);
    next(error);
  }
};

// Get single registration by ID
export const getRegistrationById = async (req, res, next) => {
  try {
    const { id } = req.params;
    const db = getRawSQLiteDB();
    
    if (!db) {
      return res.status(500).json({
        success: false,
        message: 'Database not available'
      });
    }

    const registration = db.prepare('SELECT * FROM data_registrations WHERE _id = ?').get(id);

    if (!registration) {
      return res.status(404).json({
        success: false,
        message: 'Registration not found'
      });
    }

    res.json({
      success: true,
      data: { ...registration, id: registration._id }
    });
  } catch (error) {
    console.error('Failed to get registration:', error);
    next(error);
  }
};

